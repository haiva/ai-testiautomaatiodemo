# Kopioi tiedostoksi .env TAI aseta shellin profiiliin. Älä commitoi oikeita arvoja.
export YLE_USER="<Yle Tunnus -sähköposti>"
export YLE_PASSWORD="<kysy kouluttajalta>"
export ANDROID_HOME="$HOME/Library/Android/sdk"   # Windows: C:\Android\Sdk käyttäjän ympäristömuuttujana, ks. README "Windows 11"
